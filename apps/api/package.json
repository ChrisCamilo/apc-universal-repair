{
  "name": "@apc/api",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "predev": "pnpm run db:generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm run db:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node --conditions=apc-dist dist/server.js",
    "prestart:home": "pnpm run db:generate",
    "start:home": "prisma migrate deploy && tsx src/server.ts",
    "db:generate": "prisma generate && prisma generate --config prisma.sqlite.config.ts",
    "predb:seed": "pnpm run db:generate",
    "db:seed": "prisma db seed",
    "prephotos:compress": "pnpm run db:generate",
    "photos:compress": "tsx src/photos/compressStored.ts",
    "lint": "eslint src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "pretest:db": "pnpm run db:generate",
    "test:db": "tsx --test \"src/**/*.db-test.ts\"",
    "pretypecheck": "pnpm run db:generate",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@apc/shared": "workspace:*",
    "@fastify/multipart": "^10.1.2",
    "@fastify/type-provider-zod": "^1.0.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
