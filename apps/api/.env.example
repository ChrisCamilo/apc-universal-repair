# The database: a SQLite file in apps/api/data, or PostgreSQL (see docs/database.md).
DATABASE_URL="file:./data/apc.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/apc_universal_repair"
# The port the API listens on; 3333 with `pnpm dev` and 3000 otherwise when left out (see @apc/shared/server).
# PORT=3333
# Folder the item photos and their thumbnails are stored in; "uploads/photos" when left out.
PHOTOS_DIR="uploads/photos"
# Names besides localhost and this computer's addresses the API answers for, comma separated, e.g. "oficina.local".
# APC_ALLOWED_HOSTS=""
