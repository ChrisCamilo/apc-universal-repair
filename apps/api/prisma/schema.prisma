generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A vehicle brand, the list the item form picks the vehicle brand from. nameKey holds the name in lowercase
/// without accents or extra spaces, so names that differ only in those are the same brand (see @apc/shared/lists).
model Brand {
  id      String         @id @default(uuid())
  name    String         @unique
  nameKey String         @unique
  models  VehicleModel[]
  items   Item[]
}

/// An item category, the list the item form picks the category from; nameKey as in Brand.
model Category {
  id      String @id @default(uuid())
  name    String
  nameKey String @unique
  items   Item[]
}

/// An inventory item. nameKey and codeKey hold the name without accents in lowercase and the code with
/// letters and digits only, so searches ignore accents and separators (see @apc/shared/items). Its category, part
/// brand, vehicle brand and vehicle model are entries of their lists, which can't be deleted while an item uses them.
model Item {
  id             String        @id @default(uuid())
  /// Part code, stored in uppercase and unique.
  code           String        @unique
  /// The code as the search compares it, also unique, so codes that differ only in separators clash.
  codeKey        String        @unique
  name           String
  nameKey        String
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partBrandId    String
  partBrand      PartBrand     @relation(fields: [partBrandId], references: [id], onDelete: Restrict)
  vehicleBrandId String
  vehicleBrand   Brand         @relation(fields: [vehicleBrandId], references: [id], onDelete: Restrict)
  /// A model of the vehicle brand; none when the part fits any model of the brand.
  vehicleModelId String?
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)
  position       Position      @default(NA)
  side           Side          @default(NA)
  /// Free text, "N/A" when the color doesn't apply.
  color          String        @default("N/A")
  location       String?
  quantity       Int           @default(0)
  minQuantity    Int           @default(0)
  /// Unit price in BRL, in cents, so prices add up without rounding errors.
  unitPriceCents Int
  /// Photos in order, the first one the cover.
  photos         ItemPhoto[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId])
  @@index([partBrandId])
  @@index([vehicleBrandId])
  @@index([vehicleModelId])
}

/// A photo of an item. The original file and its thumbnail are stored by the API under PHOTOS_DIR, named after the
/// photo's id; position orders the item's photos from 0, the cover.
model ItemPhoto {
  id        String @id @default(uuid())
  itemId    String
  item      Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position  Int
  /// Name of the original file, e.g. "<id>.jpg".
  file      String
  /// Name of the thumbnail, e.g. "<id>-thumb.webp".
  thumbFile String

  @@unique([itemId, position])
}

/// A part brand, the list the item form picks the part brand from; nameKey as in Brand.
model PartBrand {
  id      String @id @default(uuid())
  name    String
  nameKey String @unique
  items   Item[]
}

/// Where a part fits, front to back: not applicable (the API's "N/A"), front ("D"), rear ("T") or both ("Ambos").
enum Position {
  NA
  FRONT
  REAR
  BOTH
}

/// Where a part fits, side to side: not applicable (the API's "N/A"), right ("LD"), left ("LE") or both ("Ambos").
enum Side {
  NA
  RIGHT
  LEFT
  BOTH
}

/// Someone who logs in. The username is kept in lowercase (see @apc/shared/auth), so names that differ only in case
/// are the same user. The password is kept only as its salted scrypt hash, which the API never sends.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  /// Collected on sign-up and kept; nothing is sent to it yet.
  email        String
  /// "scrypt$<salt>$<hash>", in hex.
  passwordHash String
  createdAt    DateTime @default(now())
}

/// A vehicle model of a vehicle brand, unique within it; nameKey as in Brand.
model VehicleModel {
  id      String @id @default(uuid())
  name    String
  nameKey String
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items   Item[]

  @@unique([brandId, nameKey])
}
