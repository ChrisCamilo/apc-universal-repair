generator client {
  provider = "prisma-client"
  output   = "../../src/generated/sqlite"
}

datasource db {
  provider = "sqlite"
}

/// A vehicle brand, the list the item form picks the vehicle brand from. nameKey holds the name in lowercase
/// without accents or extra spaces, so names that differ only in those are the same brand (see @apc/domain/lists).
model Brand {
  id          String         @id @default(uuid())
  name        String         @unique
  nameKey     String         @unique
  models      VehicleModel[]
  vehicles    ItemVehicle[]
  /// Set when the Catalog tab has the brand.
  catalog     CatalogBrand?
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion Int            @default(0)

  @@index([syncVersion])
}

/// A brand of the Catalog tab: a vehicle brand of the lists, which then can't be deleted or merged away, with the
/// letters on its line on a phone and its place in the rail, from 0. The catalog a new database starts with comes in
/// its migration (20261106000000_catalog).
model CatalogBrand {
  id          String @id @default(uuid())
  brandId     String @unique
  brand       Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  /// E.g. "CH" for Chevrolet.
  mark        String
  position    Int
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion Int    @default(0)

  @@index([syncVersion])
}

/// An engine of a catalog year, with its sheet. Its name in the tree comes from the sheet ("4.1 L 6 cilindros") and its
/// year from the year above it, so neither is kept twice.
model CatalogEngine {
  id             String      @id @default(uuid())
  yearId         String
  year           CatalogYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  position       Int
  /// In decilitres, 41 for 4.1 L, so it is never rounded.
  displacementDl Int
  cylinders      Int
  drive          EngineDrive
  summary        String
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion    Int         @default(0)

  @@index([yearId])
  @@index([syncVersion])
}

/// A generation of a catalog model and its years; lastYear is null while it is still made.
model CatalogGeneration {
  id          String           @id @default(uuid())
  modelId     String
  model       CatalogModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  position    Int
  name        String
  firstYear   Int
  lastYear    Int?
  versions    CatalogVersion[]
  /// The item vehicles of this generation, which keep it from being deleted.
  vehicles    ItemVehicle[]
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion Int              @default(0)

  @@index([modelId])
  @@index([syncVersion])
}

/// A model of the Catalog tab: a vehicle model of the lists, of a catalog brand, which then can't be deleted or merged
/// away; position orders its brand's models from 0.
model CatalogModel {
  id             String              @id @default(uuid())
  vehicleModelId String              @unique
  vehicleModel   VehicleModel        @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)
  position       Int
  generations    CatalogGeneration[]
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion    Int                 @default(0)

  @@index([syncVersion])
}

/// A version of a catalog generation, e.g. Diplomata.
model CatalogVersion {
  id           String            @id @default(uuid())
  generationId String
  generation   CatalogGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  position     Int
  name         String
  years        CatalogYear[]
  /// The item vehicles of this version, which keep it from being deleted.
  vehicles     ItemVehicle[]
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion  Int               @default(0)

  @@index([generationId])
  @@index([syncVersion])
}

/// A period of a catalog version: its first and last model year, the same for a single year, with the engines it had.
/// Its level keeps the name "year" in the API (/catalog/years), as before periods.
model CatalogYear {
  id          String          @id @default(uuid())
  versionId   String
  version     CatalogVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position    Int
  /// The period's first year.
  year        Int
  /// The period's last year, not before the first.
  lastYear    Int
  engines     CatalogEngine[]
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion Int             @default(0)

  @@index([versionId])
  @@index([syncVersion])
}

/// An item category, the list the item form picks the category from; nameKey as in Brand.
model Category {
  id          String @id @default(uuid())
  name        String
  nameKey     String @unique
  items       Item[]
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion Int    @default(0)

  @@index([syncVersion])
}

/// A device a user logs in from (see @apc/domain/devices): only its public key, the name the approver gave it and its
/// dates, nothing else about the device or its owner. Pending until the server's computer authorizes it; deleting it
/// ends its sessions.
model Device {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The device's ECDSA P-256 public key, SPKI in base64url; its private key never leaves the device.
  publicKey  String
  status     DeviceStatus @default(PENDING)
  /// The name the approver gave it; empty until then, when the apps show "Dispositivo <code>".
  name       String       @default("")
  createdAt  DateTime     @default(now())
  approvedAt DateTime?
  /// When it last logged in.
  lastUsedAt DateTime?
  sessions   Session[]

  @@unique([userId, publicKey])
}

/// Whether the server's computer has authorized a device yet.
enum DeviceStatus {
  PENDING
  AUTHORIZED
}

/// Which wheels a catalog engine drives.
enum EngineDrive {
  FRONT
  REAR
  ALL
}

/// An inventory item: a part, made by one brand or more (see ItemBrand), which replace each other. nameKey holds the
/// name without accents in lowercase, so searches ignore accents (see @apc/domain/items). It fits one vehicle or more
/// (see ItemVehicle). Its category and its vehicles' brands and models are entries of their lists, which can't be
/// deleted while an item uses them. quantity is the sum
/// of its brands' quantities, kept by the API on every change to them, so the list filters and sorts by it; the item
/// is low on stock when that sum reaches minQuantity.
model Item {
  id            String             @id @default(uuid())
  name          String
  nameKey       String
  categoryId    String
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// The vehicles the part fits, in order (see ItemVehicle.position).
  vehicles      ItemVehicle[]
  position      Position           @default(NA)
  side          Side               @default(NA)
  /// The sum of the brands' quantities.
  quantity      Int                @default(0)
  minQuantity   Int                @default(0)
  /// What the part is made of, e.g. "Alumínio"; null when not given.
  material      String?
  /// A short note that tells the part apart, up to 30 characters, shown under its photo; null when not given.
  description   String?
  /// The brands that make the part, in order (see ItemBrand.position), the first one the item's cover.
  brands        ItemBrand[]
  /// The vehicle maker's codes of the part, in order (see ItemOriginalCode.position).
  originalCodes ItemOriginalCode[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion   Int                @default(0)

  @@index([categoryId])
  @@index([syncVersion])
}

/// A brand that makes an item's part, with its own part code, stock and price. codeKey holds the code with letters
/// and digits only, so searches ignore separators; both are unique across the stock. A part brand makes an item once.
/// An item from before brands were added kept its id for its brand, so its photos moved there as they were.
model ItemBrand {
  id             String      @id @default(uuid())
  itemId         String
  item           Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// The brand's place among the item's brands, from 0, the cover's.
  position       Int         @default(0)
  partBrandId    String
  partBrand      PartBrand   @relation(fields: [partBrandId], references: [id], onDelete: Restrict)
  /// Part code, stored in uppercase and unique.
  code           String      @unique
  /// The code as the search compares it, also unique, so codes that differ only in separators clash.
  codeKey        String      @unique
  /// Free text in uppercase, "N/A" when the color doesn't apply.
  color          String      @default("N/A")
  location       String?
  quantity       Int         @default(0)
  /// Unit price in BRL, in cents, so prices add up without rounding errors.
  unitPriceCents Int
  /// Photos in order, the first one the cover.
  photos         ItemPhoto[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion    Int         @default(0)

  @@unique([itemId, partBrandId])
  @@index([partBrandId])
  @@index([syncVersion])
}

/// A code the vehicle maker gave an item's part (OEM), the same for every brand of the item.
model ItemOriginalCode {
  id       String @id @default(uuid())
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// The code's place among the item's original codes, from 0.
  position Int
  /// Stored in uppercase and unique; the API also keeps it apart from every brand's code.
  code     String @unique
  /// The code as the search compares it, also unique.
  codeKey  String @unique

  @@index([itemId])
}

/// A vehicle an item's part fits: a vehicle brand and, optionally, one of its models; without one, any model of the
/// brand; and optionally a generation of the model in the Catalog, and a version of that generation. The years and the
/// version's name are the catalog's, so they change with it, and a generation or version an item uses can't be
/// deleted. position orders the item's vehicles from 0. The API keeps each vehicle once in an item, and Universal alone.
/// An item from before vehicles were added kept its id for its first vehicle.
model ItemVehicle {
  id             String             @id @default(uuid())
  itemId         String
  item           Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position       Int
  vehicleBrandId String
  vehicleBrand   Brand              @relation(fields: [vehicleBrandId], references: [id], onDelete: Restrict)
  vehicleModelId String?
  vehicleModel   VehicleModel?      @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)
  /// Its model's generation in the Catalog; null without a generation.
  generationId   String?
  generation     CatalogGeneration? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  /// A version of that generation; null when not given.
  versionId      String?
  version        CatalogVersion?    @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([vehicleBrandId])
  @@index([vehicleModelId])
  @@index([generationId])
  @@index([versionId])
}

/// A photo of an item's brand. The photo, reduced to WebP, and its thumbnail are stored by the API under PHOTOS_DIR,
/// named after the photo's id; position orders the brand's photos from 0, the cover.
model ItemPhoto {
  id          String    @id @default(uuid())
  brandId     String
  brand       ItemBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  position    Int
  /// Name of the reduced photo, e.g. "<id>.webp" (photos stored before the reduction may still be "<id>.jpg" until
  /// `pnpm --filter @apc/api photos:compress` runs).
  file        String
  /// Name of the thumbnail, e.g. "<id>-thumb.webp".
  thumbFile   String
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion Int       @default(0)

  @@unique([brandId, position])
  @@index([syncVersion])
}

/// A part brand, the list the item form picks each brand of an item from; nameKey as in Brand.
model PartBrand {
  id          String      @id @default(uuid())
  name        String
  nameKey     String      @unique
  brands      ItemBrand[]
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion Int         @default(0)

  @@index([syncVersion])
}

/// Where a part fits, front to back: not applicable (the API's "N/A"), front ("D"), rear ("T") or both ("Ambos").
enum Position {
  NA
  FRONT
  REAR
  BOTH
}

/// A user logged in on one device, from a login or sign-up until they log out or it goes 7 days unused. The token the
/// device sends is kept only as its SHA-256 hash, so the table alone can't be used to log in.
model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The device it was started from; removing the device ends it.
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token, in hex.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  /// Kept to the hour: a request refreshes it, and expiresAt, once an hour at most.
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([deviceId])
}

/// Where a part fits, side to side: not applicable (the API's "N/A"), right ("LD"), left ("LE") or both ("Ambos").
enum Side {
  NA
  RIGHT
  LEFT
  BOTH
}

/// The change feed's state, in its one row (id 1). Triggers on every synced table (each model with a syncVersion) give a
/// row the next version on each insert and update, and keep a tombstone of each delete, so every write reaches the
/// feed whatever makes it; a change to an item's vehicles or original codes gives the item a new version. The version
/// is taken by updating this row, which holds its lock until the write's transaction ends, so versions are seen
/// in the order they were given.
model SyncState {
  id            Int    @id
  /// Made when the feed's migration runs, and carried by every cursor, so a cursor of the database this one was
  /// copied or imported from isn't read here.
  databaseId    String
  /// The last version given.
  version       Int    @default(0)
  /// The version of the last tombstone dropped: a cursor before it can't learn every deletion.
  prunedVersion Int    @default(0)
}

/// A row deleted from a synced table, kept so the feed can say so: its kind as the feed names it ("itemBrand"), its
/// id, the version of its deletion and when, so the old ones can be dropped (see SyncState.prunedVersion).
model SyncTombstone {
  version   Int      @id
  kind      String
  rowId     String
  deletedAt DateTime @default(now())
}

/// Someone who logs in. The username is kept in lowercase (see @apc/domain/auth), so names that differ only in case
/// are the same user. The password is kept only as its salted scrypt hash, which the API never sends.
model User {
  id                      String    @id @default(uuid())
  username                String    @unique
  displayName             String
  /// Collected on sign-up and kept; nothing is sent to it yet.
  email                   String
  /// "scrypt$<salt>$<hash>", in hex.
  passwordHash            String
  createdAt               DateTime  @default(now())
  /// When the user first saw the Inventory tutorial; null until then, so it runs by itself on their first login only.
  inventoryTutorialSeenAt DateTime?
  sessions                Session[]
  devices                 Device[]
}

/// A vehicle model of a vehicle brand, unique within it; nameKey as in Brand.
model VehicleModel {
  id           String        @id @default(uuid())
  name         String
  nameKey      String
  brandId      String
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  vehicles     ItemVehicle[]
  /// Set when the Catalog tab has the model.
  catalogModel CatalogModel?
  /// Grows with every change of the row, as the change feed sends it (see SyncState).
  syncVersion  Int           @default(0)

  @@unique([brandId, nameKey])
  @@index([syncVersion])
}
