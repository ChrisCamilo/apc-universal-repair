generator client {
  provider = "prisma-client"
  output   = "../../src/generated/sqlite"
}

datasource db {
  provider = "sqlite"
}

/// A vehicle brand, the list the item form picks the vehicle brand from. nameKey holds the name in lowercase
/// without accents or extra spaces, so names that differ only in those are the same brand (see @apc/shared/lists).
model Brand {
  id      String         @id @default(uuid())
  name    String         @unique
  nameKey String         @unique
  models  VehicleModel[]
  items   Item[]
}

/// An item category, the list the item form picks the category from; nameKey as in Brand.
model Category {
  id      String @id @default(uuid())
  name    String
  nameKey String @unique
  items   Item[]
}

/// An inventory item: a part, made by one brand or more (see ItemBrand), which replace each other. nameKey holds the
/// name without accents in lowercase, so searches ignore accents (see @apc/shared/items). Its category, vehicle brand
/// and vehicle model are entries of their lists, which can't be deleted while an item uses them. quantity is the sum
/// of its brands' quantities, kept by the API on every change to them, so the list filters and sorts by it; the item
/// is low on stock when that sum reaches minQuantity.
model Item {
  id             String             @id @default(uuid())
  name           String
  nameKey        String
  categoryId     String
  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vehicleBrandId String
  vehicleBrand   Brand              @relation(fields: [vehicleBrandId], references: [id], onDelete: Restrict)
  /// A model of the vehicle brand; none when the part fits any model of the brand.
  vehicleModelId String?
  vehicleModel   VehicleModel?      @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)
  position       Position           @default(NA)
  side           Side               @default(NA)
  /// The sum of the brands' quantities.
  quantity       Int                @default(0)
  minQuantity    Int                @default(0)
  /// The brands that make the part, in order (see ItemBrand.position), the first one the item's cover.
  brands         ItemBrand[]
  /// The vehicle maker's codes of the part, in order (see ItemOriginalCode.position).
  originalCodes  ItemOriginalCode[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([categoryId])
  @@index([vehicleBrandId])
  @@index([vehicleModelId])
}

/// A brand that makes an item's part, with its own part code, stock and price. codeKey holds the code with letters
/// and digits only, so searches ignore separators; both are unique across the stock. A part brand makes an item once.
/// An item from before brands were added kept its id for its brand, so its photos moved there as they were.
model ItemBrand {
  id             String      @id @default(uuid())
  itemId         String
  item           Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// The brand's place among the item's brands, from 0, the cover's.
  position       Int         @default(0)
  partBrandId    String
  partBrand      PartBrand   @relation(fields: [partBrandId], references: [id], onDelete: Restrict)
  /// Part code, stored in uppercase and unique.
  code           String      @unique
  /// The code as the search compares it, also unique, so codes that differ only in separators clash.
  codeKey        String      @unique
  /// Free text, "N/A" when the color doesn't apply.
  color          String      @default("N/A")
  location       String?
  quantity       Int         @default(0)
  /// Unit price in BRL, in cents, so prices add up without rounding errors.
  unitPriceCents Int
  /// Photos in order, the first one the cover.
  photos         ItemPhoto[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([itemId, partBrandId])
  @@index([partBrandId])
}

/// A code the vehicle maker gave an item's part (OEM), the same for every brand of the item.
model ItemOriginalCode {
  id       String @id @default(uuid())
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// The code's place among the item's original codes, from 0.
  position Int
  /// Stored in uppercase and unique; the API also keeps it apart from every brand's code.
  code     String @unique
  /// The code as the search compares it, also unique.
  codeKey  String @unique

  @@index([itemId])
}

/// A photo of an item's brand. The photo, reduced to WebP, and its thumbnail are stored by the API under PHOTOS_DIR,
/// named after the photo's id; position orders the brand's photos from 0, the cover.
model ItemPhoto {
  id        String    @id @default(uuid())
  brandId   String
  brand     ItemBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  position  Int
  /// Name of the reduced photo, e.g. "<id>.webp" (photos stored before the reduction may still be "<id>.jpg" until
  /// `pnpm --filter @apc/api photos:compress` runs).
  file      String
  /// Name of the thumbnail, e.g. "<id>-thumb.webp".
  thumbFile String

  @@unique([brandId, position])
}

/// A part brand, the list the item form picks each brand of an item from; nameKey as in Brand.
model PartBrand {
  id      String      @id @default(uuid())
  name    String
  nameKey String      @unique
  brands  ItemBrand[]
}

/// Where a part fits, front to back: not applicable (the API's "N/A"), front ("D"), rear ("T") or both ("Ambos").
enum Position {
  NA
  FRONT
  REAR
  BOTH
}

/// A user logged in on one device, from a login or sign-up until they log out or it goes 7 days unused. The token the
/// device sends is kept only as its SHA-256 hash, so the table alone can't be used to log in.
model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token, in hex.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  /// Kept to the hour: a request refreshes it, and expiresAt, once an hour at most.
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

/// Where a part fits, side to side: not applicable (the API's "N/A"), right ("LD"), left ("LE") or both ("Ambos").
enum Side {
  NA
  RIGHT
  LEFT
  BOTH
}

/// Someone who logs in. The username is kept in lowercase (see @apc/shared/auth), so names that differ only in case
/// are the same user. The password is kept only as its salted scrypt hash, which the API never sends.
model User {
  id                      String    @id @default(uuid())
  username                String    @unique
  displayName             String
  /// Collected on sign-up and kept; nothing is sent to it yet.
  email                   String
  /// "scrypt$<salt>$<hash>", in hex.
  passwordHash            String
  createdAt               DateTime  @default(now())
  /// When the user first saw the Inventory tutorial; null until then, so it runs by itself on their first login only.
  inventoryTutorialSeenAt DateTime?
  sessions                Session[]
}

/// A vehicle model of a vehicle brand, unique within it; nameKey as in Brand.
model VehicleModel {
  id      String @id @default(uuid())
  name    String
  nameKey String
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items   Item[]

  @@unique([brandId, nameKey])
}
